jmt.js\",\"/_next/static/chunks/0wlqa3t_j6b22.js\",\"/_next/static/chunks/0t698yywsb5~-.js\",\"/_next/static/chunks/0xjrnv1po9n~0.js\",\"/_next/static/chunks/1181pbou.tkp3.js\",\"/_next/static/chunks/0c-0zwsf8nv_k.js\",\"/_next/static/chunks/14p1p_ukyy748.js\"],\"OutletBoundary\"]\n12:\"$Sreact.suspense\"\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"$L2\",null,{\"children\":[\"$\",\"section\",null,{\"className\":\"section-pad\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-site max-w-4xl\",\"children\":[[\"$\",\"span\",null,{\"data-slot\":\"badge\",\"data-variant\":\"outline\",\"className\":\"group/badge inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-4xl border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-all focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3! border-border text-foreground [a]:hover:bg-muted [a]:hover:text-muted-foreground mb-4\",\"children\":\"Legal\"}],[\"$\",\"h1\",null,{\"className\":\"text-4xl font-semibold tracking-tight sm:text-5xl\",\"children\":\"Privacy Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground\",\"children\":[\"Last updated: \",\"July 25, 2026\"]}],[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"div\",\"1. Introduction\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"1. Introduction\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark LLC (\\\"Wolfitpark,\\\" \\\"we,\\\" \\\"our,\\\" or \\\"us\\\") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website or use our services. Please read this policy carefully. By accessing or using our services, you acknowledge that you have read and understood this policy.\"}]]}],[\"$\",\"div\",\"2. Information We Collect\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"2. Information We Collect\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We collect information you voluntarily provide when you register, fill out forms, submit applications, or communicate with us. This includes: (a) Personal identifiers such as name, email address, phone number, postal address, and date of birth; (b) Business information such as company name, entity type, EIN/SSN, beneficial ownership details, and business address; (c) Payment and financial information such as credit card details, bank account information, and billing addresses (processed directly by our PCI-compliant payment processors — we do not store full card numbers); (d) Identity verification documents such as government-issued IDs and passports; (e) Communication records including emails, chat messages, and support tickets.\"}]]}],[\"$\",\"div\",\"3. Information Collected Automatically\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"3. Information Collected Automatically\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"When you visit our website, we automatically collect: (a) Device and browser information including IP address, browser type, operating system, and device identifiers; (b) Usage data including pages visited, time spent, links clicked, and navigation patterns; (c) Cookies and similar tracking technologies as described in our Cookie Policy.\"}]]}],[\"$\",\"div\",\"4. How We Use Your Information\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"4. How We Use Your Information\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We use your information for the following purposes: (a) To provide, process, and manage your service requests and business formation; (b) To communicate with you about your account, services, and support inquiries; (c) To process payments and prevent fraudulent transactions; (d) To comply with legal obligations including anti-money laundering (AML) and Know Your Customer (KYC) requirements; (e) To improve our website, services, and user experience; (f) To send service-related notices, updates, and security alerts; (g) To enforce our terms, policies, and legal agreements.\"}]]}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\"]}]]}]}]}],[\"$Le\",\"$Lf\"],\"$L10\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"7Vv3iCIXWtJ6yC8ihbTCf\"}\n3:[\"$\",\"div\",\"5. Lawful Basis for Processing (GDPR)\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"5. Lawful Basis for Processing (GDPR)\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If you are located in the European Economic Area (EEA), our lawful bases for processing your personal data include: (a) Performance of a contract — to deliver services you have requested; (b) Legal obligation — to comply with applicable laws and regulations; (c) Legitimate interests — to operate and improve our business; (d) Consent — where you have provided explicit consent for specific processing activities.\"}]]}]\n4:[\"$\",\"div\",\"6. Data Sharing and Disclosure\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"6. Data Sharing and Disclosure\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We do not sell your personal information. We may share your information with: (a) Service providers who assist in business operations — payment processors (Stripe, Coinbase Commerce), identity verification services, cloud infrastructure providers (AWS, Vercel), email and communication services; (b) Government authorities and regulatory bodies as required by law, including state filing offices, IRS, FinCEN, and law enforcement; (c) Professional advisors including attorneys, accountants, and auditors; (d) Business partners with your consent or as necessary to provide services you request. All third-party service providers are contractually obligated to maintain confidentiality and implement appropriate security measures.\"}]]}]\n5:[\"$\",\"div\",\"7. PCI DSS Compliance\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"7. PCI DSS Compliance\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark is committed to PCI DSS (Payment Card Industry Data Security Standard) compliance. We do not store, process, or transmit credit card numbers on our servers. All payment transactions are handled by PCI DSS Level 1 certified payment processors. We implement the following security measures: (a) Cardholder data is never stored, logged, or cached on our systems; (b) All payment pages are served over TLS 1.2+ encryption; (c) We use tokenization to replace card data with secure tokens; (d) Regular security scans and penetration testing are conducted; (e) Access to payment systems is restricted on a need-to-know basis; (f) Security policies are reviewed and updated annually.\"}]]}]\n6:[\"$\",\"div\",\"8. Data Security\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"8. Data Security\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We implement industry-standard technical, administrative, and physical security measures to protect your information, including: (a) AES-256 encryption for data at rest; (b) TLS 1.2+ encryption for data in transit; (c) Multi-factor authentication for system access; (d) Regular security audits and vulnerability assessments; (e) Employee training on data protection and privacy; (f) Incident response and breach notification procedures.\"}]]}]\n7:[\"$\",\"div\",\"9. Data Retention\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"9. Data Retention\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We retain your personal information for as long as necessary to fulfill the purposes described in this policy, or as required by applicable law (typically 5-7 years after the end of our business relationship for compliance and legal purposes). When data is no longer needed, it is securely deleted or anonymized.\"}]]}]\n8:[\"$\",\"div\",\"10. Your Rights\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"10. Your Rights\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Depending on your jurisdiction, you may have the following rights: (a) Right to access — request a copy of your personal data; (b) Right to rectification — correct inaccurate or incomplete data; (c) Right to deletion — request deletion of your data, subject to legal requirements; (d) Right to restrict processing — limit how we use your data; (e) Right to data portability — receive your data in a structured format; (f) Right to object — object to processing based on legitimate interests; (g) Rights under the California Consumer Privacy Act (CCPA) — know, delete, and opt-out of the sale of personal information. To exercise your rights, contact privacy@wolfitpark.online. We will respond within 30 days.\"}]]}]\n9:[\"$\",\"div\",\"11. International Data Transfers\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"11. International Data Transfers\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Your information may be transferred to and processed in the United States and other countries where we or our service providers operate. We ensure appropriate safeguards are in place through Standard Contractual Clauses (SCCs) and data processing agreements.\"}]]}]\na:[\"$\",\"div\",\"12. Children's Privacy\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"12. Children's Privacy\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Our services are not directed to individuals under the age of 18. We do not knowingly collect personal information from children. If we become aware of such collection, we will delete the information promptly.\"}]]}]\nb:[\"$\",\"div\",\"13. Third-Party Links\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"13. Third-Party Links\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Our website may contain links to third-party websites. We are not responsible for the privacy practices or content of these external sites. We encourage you to review their privacy policies before providing any personal information.\"}]]}]\nc:[\"$\",\"div\",\"14. Changes to This Policy\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"14. Changes to This Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We may update this Privacy Policy from time to time. Material changes will be communicated via email or a prominent notice on our website. Your continued use of our services after changes constitutes acceptance of the updated policy.\"}]]}]\nd:[\"$\",\"div\",\"15. Contact Us\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"15. Contact Us\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If you have questions, concerns, or requests regarding this Privacy Policy or our data practices, please contact us at: Wolfitpark LLC, 30 N Gould St, Sheridan, WY 82801, USA. Email: privacy@wolfitpark.online. Phone: +1 (307) 555-0199.\"}]]}]\ne:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/152qdn4mqqc97.js\",\"async\":true}]\nf:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0fwfw3zr_x.b_.js\",\"async\":true}]\n10:[\"$\",\"$L11\",null,{\"children\":[\"$\",\"$12\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@13\"}]}]\n13:null\n","/privacy":"1:\"$Sreact.fragment\"\n2:I[12224,[\"/_next/static/chunks/0w2c.i2ky0ich.js\",\"/_next/static/chunks/0anfux3ged1uf.js\",\"/_next/static/chunks/09l_6s1m2kd2f.js\",\"/_next/static/chunks/02b7ej9gu8jmt.js\",\"/_next/static/chunks/0wlqa3t_j6b22.js\",\"/_next/static/chunks/0t698yywsb5~-.js\",\"/_next/static/chunks/0xjrnv1po9n~0.js\",\"/_next/static/chunks/1181pbou.tkp3.js\",\"/_next/static/chunks/0c-0zwsf8nv_k.js\",\"/_next/static/chunks/14p1p_ukyy748.js\"],\"default\"]\n3:I[67689,[\"/_next/static/chunks/0w2c.i2ky0ich.js\",\"/_next/static/chunks/0anfux3ged1uf.js\",\"/_next/static/chunks/09l_6s1m2kd2f.js\",\"/_next/static/chunks/02b7ej9gu8jmt.js\",\"/_next/static/chunks/0wlqa3t_j6b22.js\",\"/_next/static/chunks/0t698yywsb5~-.js\",\"/_next/static/chunks/0xjrnv1po9n~0.js\",\"/_next/static/chunks/1181pbou.tkp3.js\",\"/_next/static/chunks/0c-0zwsf8nv_k.js\",\"/_next/static/chunks/14p1p_ukyy748.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":\"$W4\",\"buildId\":\"7Vv3iCIXWtJ6yC8ihbTCf\"}\n","/_index":"1:I[12224,[\"/_next/static/chunks/0w2c.i2ky0ich.js\",\"/_next/static/chunks/0anfux3ged1uf.js\",\"/_next/static/chunks/09l_6s1m2kd2f.js\",\"/_next/static/chunks/02b7ej9gu8jmt.js\",\"/_next/static/chunk