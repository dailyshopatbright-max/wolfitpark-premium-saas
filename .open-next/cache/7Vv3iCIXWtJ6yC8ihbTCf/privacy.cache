xt-white/60 transition-colors hover:text-white\\\",\\\"href\\\":\\\"/refund\\\",\\\"children\\\":\\\"Refund Policy\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"Legal-Shipping Policy\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L2c\\\",null,{\\\"className\\\":\\\"text-sm text-white/60 transition-colors hover:text-white\\\",\\\"href\\\":\\\"/shipping\\\",\\\"children\\\":\\\"Shipping Policy\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"Legal-Cookie Policy\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L2c\\\",null,{\\\"className\\\":\\\"text-sm text-white/60 transition-colors hover:text-white\\\",\\\"href\\\":\\\"/cookies\\\",\\\"children\\\":\\\"Cookie Policy\\\"}]}]]}]]}]\\n34:[\\\"$\\\",\\\"div\\\",\\\"Incorporation\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-white/90\\\",\\\"children\\\":\\\"Incorporation\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"mt-4 flex flex-col gap-3\\\",\\\"children\\\":\"])</script><script>self.__next_f.push([1,\"[[\\\"$\\\",\\\"li\\\",\\\"Incorporation-Start Company\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L2c\\\",null,{\\\"className\\\":\\\"text-sm text-white/60 transition-colors hover:text-white\\\",\\\"href\\\":\\\"/incorporation\\\",\\\"children\\\":\\\"Start Company\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"Incorporation-State Comparison\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L2c\\\",null,{\\\"className\\\":\\\"text-sm text-white/60 transition-colors hover:text-white\\\",\\\"href\\\":\\\"/incorporation/states\\\",\\\"children\\\":\\\"State Comparison\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"Incorporation-Dashboard\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L2c\\\",null,{\\\"className\\\":\\\"text-sm text-white/60 transition-colors hover:text-white\\\",\\\"href\\\":\\\"/dashboard\\\",\\\"children\\\":\\\"Dashboard\\\"}]}]]}]]}]\\n35:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col gap-6 border-t border-white/15 pt-8 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"© 2026 Wolfitpark. All rights reserved.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-center gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L2c\\\",null,{\\\"href\\\":\\\"/privacy\\\",\\\"className\\\":\\\"transition-colors hover:text-white\\\",\\\"children\\\":\\\"Privacy\\\"}],[\\\"$\\\",\\\"$L2c\\\",null,{\\\"href\\\":\\\"/terms\\\",\\\"className\\\":\\\"transition-colors hover:text-white\\\",\\\"children\\\":\\\"Terms\\\"}],[\\\"$\\\",\\\"$L2c\\\",null,{\\\"href\\\":\\\"/refund\\\",\\\"className\\\":\\\"transition-colors hover:text-white\\\",\\\"children\\\":\\\"Refunds\\\"}],[\\\"$\\\",\\\"$L2c\\\",null,{\\\"href\\\":\\\"/shipping\\\",\\\"className\\\":\\\"transition-colors hover:text-white\\\",\\\"children\\\":\\\"Shipping\\\"}],[\\\"$\\\",\\\"$L2c\\\",null,{\\\"href\\\":\\\"/cookies\\\",\\\"className\\\":\\\"transition-colors hover:text-white\\\",\\\"children\\\":\\\"Cookies\\\"}]]}]]}]\\n37:[\\\"$\\\",\\\"div\\\",\\\"5. Lawful Basis for Processing (GDPR)\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"5. Lawful Basis for Processing (GDPR)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"If you are located in the European Economic Area (EEA), our lawful bases for processing your personal data include: (a) Performance of a contract — to deliver services you have requested; (b) Legal obligation — to comply with applicable laws and regulations; (c) Legitimate interests — to operate and improve our business; (d) Consent — where you have provided explicit consent for specific processing activities.\\\"}]]}]\\n38:[\\\"$\\\",\\\"div\\\",\\\"6. Data Sharing and Disclosure\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"6. Data Sharing and Disclosure\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We do not sell your personal information. We may share your information with: (a) Service providers who assist in business operations — payment processors (Stripe, Coinbase Commerce), identity verification services, cloud infrastructure providers (AWS, Vercel), email and communication services; (b) Government authorities and regulatory bodies as required by law, including state filing offices, IRS, FinCEN, and law enforcement; (c) Professional advisors including attorneys, accountants, and auditors; (d) Business partners with your consent or as necessary to provide services you request. All third-party service providers are contractually obligated to maintain confidentiality and implement appropriate security measures.\\\"}]]}]\\n39:[\\\"$\\\",\\\"div\\\",\\\"7. PCI DSS Compliance\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"7. PCI DSS Compliance\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Wolfitpark is committed to PCI DSS (Payment Card Industry Data Security Standard) compliance. We do not store, process, or transmit credit card numbers on our servers. All payment transactions are handled by PCI DSS Level 1 certified payment processors. We implement the following security measures: (a) Cardholder data is never stored, logged, or cached on our systems; (b) All payment pages are served over TLS 1.2+ encryption; (c) We use tokenization to replace card data with secure tokens; (d) Regular security scans and penetration testing are conducted; (e) Access to payment systems is restricted on a need-to-know basis; (f) Security policies are reviewed and updated annually.\\\"}]]}]\\n3a:[\\\"$\\\",\\\"div\\\",\\\"8. Data Security\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"c\"])</script><script>self.__next_f.push([1,\"lassName\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"8. Data Security\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We implement industry-standard technical, administrative, and physical security measures to protect your information, including: (a) AES-256 encryption for data at rest; (b) TLS 1.2+ encryption for data in transit; (c) Multi-factor authentication for system access; (d) Regular security audits and vulnerability assessments; (e) Employee training on data protection and privacy; (f) Incident response and breach notification procedures.\\\"}]]}]\\n3b:[\\\"$\\\",\\\"div\\\",\\\"9. Data Retention\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"9. Data Retention\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We retain your personal information for as long as necessary to fulfill the purposes described in this policy, or as required by applicable law (typically 5-7 years after the end of our business relationship for compliance and legal purposes). When data is no longer needed, it is securely deleted or anonymized.\\\"}]]}]\\n3c:[\\\"$\\\",\\\"div\\\",\\\"10. Your Rights\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"10. Your Rights\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Depending on your jurisdiction, you may have the following rights: (a) Right to access — request a copy of your personal data; (b) Right to rectification — correct inaccurate or incomplete data; (c) Right to deletion — request deletion of your data, subject to legal requirements; (d) Right to restrict processing — limit how we use your data; (e) Right to data portability — receive your data in a structured format; (f) Right to object — object to processing based on legitimate interests; (g) Rights under the California Consumer Privacy Act (CCPA) — know, delete, and opt-out of the sale of personal information. To exercise your rights, contact privacy@wolfitpark.online. We will respond within 30 days.\\\"}]]}]\\n3d:[\\\"$\\\",\\\"div\\\",\\\"11. International Data Transfers\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"11. International Data Transfers\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Your information may be transferred to and processed in the United States and other countries where we or our service providers operate. We ensure appropriate safeguards are in place through Standard Contractual Clauses (SCCs) and data processing agreements.\\\"}]]}]\\n3e:[\\\"$\\\",\\\"div\\\",\\\"12. Children's Privacy\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"12. Children's Privacy\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Our services are not directed to individuals under the age of 18. We do not knowingly collect personal information from children. If we become aware of such collection, we will delete the information promptly.\\\"}]]}]\\n3f:[\\\"$\\\",\\\"div\\\",\\\"13. Third-Party Links\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"13. Third-Party Links\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Our website may contain links to third-party websites. We are not responsible for the privacy practices or content of these external sites. We encourage you to review their privacy policies before providing any personal information.\\