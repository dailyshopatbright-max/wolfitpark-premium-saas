{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"2. Physical Mail Forwarding\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"If you subscribe to our Virtual Business Address service with mail forwarding: (a) Physical mail is received at 30 N Gould St, Sheridan, WY 82801; (b) Mail is scanned and uploaded to your dashboard within 1-2 business days of receipt; (c) You may request physical forwarding of mail pieces; (d) Standard forwarding occurs weekly via USPS Priority Mail; (e) Expedited forwarding (next-day) is available for an additional fee; (f) We are not responsible for delays or loss caused by USPS or other carriers.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"3. Shipping Costs\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"3. Shipping Costs\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Mail forwarding shipping costs are included in your virtual address plan for standard (weekly) forwarding within the United States. Expedited shipping and international forwarding are available at additional cost as specified during sign-up or quoted upon request.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"4. Processing Times\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"4. Processing Times\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Incorporation document processing depends on the filing state: (a) Expedited states (Delaware, Wyoming, Nevada) — 1-2 business days for state approval; (b) Standard states — 3-10 business days for state approval; (c) Paper filing states — 2-6 weeks for state approval. Processing times are estimates and not guaranteed. State government office closures, holidays, and workload may affect timelines.\\\"}]]}],\\\"$L37\\\",\\\"$L38\\\",\\\"$L39\\\",\\\"$L3a\\\",\\\"$L3b\\\",\\\"$L3c\\\",\\\"$L3d\\\"]}]]}]}]}],[\\\"$L3e\\\",\\\"$L3f\\\"],\\\"$L40\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"41:[]\\n26:\\\"$W41\\\"\\n27:[\\\"$\\\",\\\"$3\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L42\\\",null,{\\\"children\\\":\\\"$L43\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L44\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$45\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L46\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}]\\n29:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0ct-sps8aufrd.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]\\n2a:[\\\"$\\\",\\\"link\\\",\\\"1\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0djcck_ky6z0o.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"47:I[76779,[\\\"/_next/static/chunks/0w2c.i2ky0ich.js\\\",\\\"/_next/static/chunks/0anfux3ged1uf.js\\\",\\\"/_next/static/chunks/09l_6s1m2kd2f.js\\\",\\\"/_next/static/chunks/02b7ej9gu8jmt.js\\\",\\\"/_next/static/chunks/0wlqa3t_j6b22.js\\\",\\\"/_next/static/chunks/0t698yywsb5~-.js\\\",\\\"/_next/static/chunks/0xjrnv1po9n~0.js\\\",\\\"/_next/static/chunks/1181pbou.tkp3.js\\\",\\\"/_next/static/chunks/0c-0zwsf8nv_k.js\\\",\\\"/_next/static/chunks/14p1p_ukyy748.js\\\"],\\\"OutletBoundary\\\"]\\n2e:[\\\"$\\\",\\\"$L2c\\\",null,{\\\"className\\\":\\\"text-sm text-white/60 transition-colors hover:text-white\\\",\\\"href\\\":\\\"/services\\\",\\\"children\\\":\\\"AI \\u0026 Automation\\\"}]\\n2f:[\\\"$\\\",\\\"li\\\",\\\"Services-Cloud \\u0026 Data\\\",{\\\"children\\\":[\\\"$\\\",\\\"$L2c\