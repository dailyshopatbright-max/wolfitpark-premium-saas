ant\":\"outline\",\"className\":\"group/badge inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-4xl border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-all focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3! border-border text-foreground [a]:hover:bg-muted [a]:hover:text-muted-foreground mb-4\",\"children\":\"Legal\"}],[\"$\",\"h1\",null,{\"className\":\"text-4xl font-semibold tracking-tight sm:text-5xl\",\"children\":\"Shipping & Delivery Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground\",\"children\":[\"Last updated: \",\"July 25, 2026\"]}],[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"div\",\"1. Digital Delivery\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"1. Digital Delivery\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark LLC primarily delivers services and documents electronically. Upon successful formation or filing, you will receive: (a) Digital copies of formation documents (Certificate of Formation/Incorporation, Operating Agreement, Bylaws) available for download from your client dashboard; (b) EIN confirmation letter (CP 575) from the IRS via email and dashboard; (c) BOI filing confirmation via email; (d) All communications, invoices, and receipts are delivered electronically. Digital documents are typically available within 1-2 business days after state approval.\"}]]}],[\"$\",\"div\",\"2. Physical Mail Forwarding\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"2. Physical Mail Forwarding\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If you subscribe to our Virtual Business Address service with mail forwarding: (a) Physical mail is received at 30 N Gould St, Sheridan, WY 82801; (b) Mail is scanned and uploaded to your dashboard within 1-2 business days of receipt; (c) You may request physical forwarding of mail pieces; (d) Standard forwarding occurs weekly via USPS Priority Mail; (e) Expedited forwarding (next-day) is available for an additional fee; (f) We are not responsible for delays or loss caused by USPS or other carriers.\"}]]}],[\"$\",\"div\",\"3. Shipping Costs\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"3. Shipping Costs\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Mail forwarding shipping costs are included in your virtual address plan for standard (weekly) forwarding within the United States. Expedited shipping and international forwarding are available at additional cost as specified during sign-up or quoted upon request.\"}]]}],[\"$\",\"div\",\"4. Processing Times\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"4. Processing Times\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Incorporation document processing depends on the filing state: (a) Expedited states (Delaware, Wyoming, Nevada) — 1-2 business days for state approval; (b) Standard states — 3-10 business days for state approval; (c) Paper filing states — 2-6 weeks for state approval. Processing times are estimates and not guaranteed. State government office closures, holidays, and workload may affect timelines.\"}]]}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}]]}]}]}],[\"$La\",\"$Lb\"],\"$Lc\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"7Vv3iCIXWtJ6yC8ihbTCf\"}\n3:[\"$\",\"div\",\"5. International Shipping\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"5. International Shipping\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"International mail forwarding is available to most countries. Delivery times vary by destination: (a) Canada — 5-10 business days; (b) Europe — 7-14 business days; (c) Asia-Pacific — 10-20 business days; (d) Rest of world — 14-30 business days. Customs duties, taxes, and import fees are the responsibility of the recipient. We are not responsible for items seized or delayed by customs.\"}]]}]\n4:[\"$\",\"div\",\"6. Expedited Processing\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"6. Expedited Processing\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Expedited processing options are available for an additional fee: (a) 24-hour expedited state filing (available in select states) — $99; (b) Priority mail forwarding (next-day) — $25 per forwarding; (c) Rush document preparation — $49. Availability varies by state and service type.\"}]]}]\n5:[\"$\",\"div\",\"7. Document Replacement\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"7. Document Replacement\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If you lose or misplace your digital documents, replacement copies are available for download from your dashboard at no charge. Certified copies from the state may require additional fees.\"}]]}]\n6:[\"$\",\"div\",\"8. Returned Mail\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"8. Returned Mail\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If physical mail is returned to us as undeliverable due to an incorrect or outdated address on file, a $10 re-forwarding fee applies. We will attempt to contact you to update your address before disposal.\"}]]}]\n7:[\"$\",\"div\",\"9. Abandoned Mail\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"9. Abandoned Mail\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Physical mail held at our facility for more than 60 days without forwarding instructions or account renewal may be considered abandoned and disposed of. We will make reasonable efforts to notify you before disposal.\"}]]}]\n8:[\"$\",\"div\",\"10. Limitation of Liability\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"10. Limitation of Liability\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark is not liable for: (a) Delays caused by government agencies, postal services, or courier companies; (b) Loss of mail by USPS or third-party carriers; (c) Damages resulting from delayed delivery; (d) Customs delays, seizures, or import restrictions for international forwarding.\"}]]}]\n9:[\"$\",\"div\",\"11. Contact\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"11. Contact\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"For questions about shipping and delivery, contact: Wolfitpark LLC, 30 N Gould St, Sheridan, WY 82801, USA. Email: support@wolfitpark.online. Phone: +1 (307) 555-0199.\"}]]}]\na:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/152qdn4mqqc97.js\",\"async\":true}]\nb:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0fwfw3zr_x.b_.js\",\"async\":true}]\nc:[\"$\",\"$Ld\",null,{\"children\":[\"$\",\"$e\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@f\"}]}]\nf:null\n","/shipping":"1:\"$Sreact.fragment\"\n2:I[12224,[\"/_next/static/chunks/0w2c.i2ky0ich.js\",\"/_next/static/chunks/0anfux3ged1uf.js\",\"/_next/static/chunks/09l_6s1m2kd2f.js\",\"/_next/static/chunk