y 25, 2026\"]}],[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"div\",\"1. Overview\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"1. Overview\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark LLC is committed to customer satisfaction. This Refund Policy explains your rights and our obligations regarding refunds for our services. Please review this policy carefully before making a purchase. By purchasing our services, you agree to the terms of this policy.\"}]]}],[\"$\",\"div\",\"2. Service Fees (Formation Packages)\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"2. Service Fees (Formation Packages)\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Our service fees for business formation and filing assistance are refundable according to the following schedule: (a) Full refund within 14 calendar days of purchase if we have not yet filed any documents with the state or commenced work on your order; (b) 50% refund if work has commenced but no state filing has been submitted; (c) No refund after state filing has been submitted. State processing times and outcomes are outside our control.\"}]]}],[\"$\",\"div\",\"3. State Filing Fees\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"3. State Filing Fees\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"State filing fees are paid directly to government agencies (Secretary of State, Department of Corporations, etc.) and are non-refundable once submitted. This applies regardless of the application outcome, including rejection or delay. We will inform you of state fees before submission.\"}]]}],[\"$\",\"div\",\"4. Registered Agent Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"4. Registered Agent Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Registered agent service fees are refundable within 14 days of purchase if the service period has not yet begun. Once the service period starts, fees are earned and non-refundable on a pro-rata basis.\"}]]}],[\"$\",\"div\",\"5. Optional Add-On Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"5. Optional Add-On Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Optional add-on services including EIN application assistance, BOI filing, mail forwarding, and virtual address: (a) Full refund within 7 days if the service has not been initiated; (b) No refund once the application or service has been submitted to the relevant authority or initiated.\"}]]}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\"]}]]}]}]}],[\"$Lb\",\"$Lc\"],\"$Ld\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"7Vv3iCIXWtJ6yC8ihbTCf\"}\n3:[\"$\",\"div\",\"6. Subscription Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"6. Subscription Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Monthly subscription services (compliance monitoring, annual report reminders, etc.): (a) Cancellable at any time; (b) You retain access until the end of your current billing period; (c) No partial refunds for unused portions of a billing period; (d) Annual subscriptions are refundable on a pro-rata basis for the unused portion, minus a 10% processing fee.\"}]]}]\n4:[\"$\",\"div\",\"7. Custom Development and Enterprise Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"7. Custom Development and Enterprise Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Custom software development, enterprise agreements, and consulting services are governed by the refund and cancellation terms specified in your individual service contract or statement of work. These typically include milestone-based payment schedules with refund terms tied to completed deliverables.\"}]]}]\n5:[\"$\",\"div\",\"8. Payment Disputes\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"8. Payment Disputes\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If you believe a charge is incorrect, please contact us immediately at billing@wolfitpark.online. We will investigate and respond within 5 business days. Unresolved disputes may be submitted to your financial institution or through binding arbitration as described in our Terms & Conditions.\"}]]}]\n6:[\"$\",\"div\",\"9. Refund Processing\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"9. Refund Processing\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Approved refunds are processed within 5-10 business days. Refunds are credited to your original payment method: (a) Credit/debit card refunds — 5-10 business days to appear on your statement; (b) Cryptocurrency refunds — processed within 24 hours, subject to blockchain network confirmations; (c) ACH/wire refunds — 5-7 business days. Cryptocurrency refunds are denominated in the original cryptocurrency at the exchange rate at the time of refund processing.\"}]]}]\n7:[\"$\",\"div\",\"10. Chargeback Policy\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"10. Chargeback Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If you initiate a chargeback with your financial institution before contacting us, your account may be immediately suspended. We will provide transaction records to your financial institution to dispute the chargeback. Wrongful chargebacks may result in a $25 administrative fee.\"}]]}]\n8:[\"$\",\"div\",\"11. Exceptions\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"11. Exceptions\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Exceptions to this Refund Policy may be made at Wolfitpark's sole discretion in extraordinary circumstances. All exceptions must be documented in writing and approved by a Wolfitpark manager.\"}]]}]\n9:[\"$\",\"div\",\"12. Governing Law\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"12. Governing Law\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"This Refund Policy is governed by the laws of the State of Wyoming, United States. Any disputes regarding refunds shall be resolved through the dispute resolution process outlined in our Terms & Conditions.\"}]]}]\na:[\"$\",\"div\",\"13. Contact\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"13. Contact\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"For refund requests or questions, contact: Wolfitpark LLC, 30 N Gould St, Sheridan, WY 82801, USA. Email: billing@wolfitpark.online. Phone: +1 (307) 555-0199.\"}]]}]\nb:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/152qdn4mqqc97.js\",\"async\":true}]\nc:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0fwfw3zr_x.b_.js\",\"async\":true}]\nd:[\"$\",\"$Le\",null,{\"children\":[\"$\",\"$f\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@10\"}]}]\n10:null\n","/refund":"1:\"$Sreact.fragment\"\n2:I[12224,[\"/_next/static/chunks/0w2c.i2ky0ich.js\",\"/_next/static/chunks/0anfux3ged1uf.js\",\"/_next/static/chunks/09l_6s1m2kd2f.js\",\"/_next/static/chunks/02b7ej9