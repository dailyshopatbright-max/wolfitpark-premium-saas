null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"State filing fees are paid directly to government agencies (Secretary of State, Department of Corporations, etc.) and are non-refundable once submitted. This applies regardless of the application outcome, including rejection or delay. We will inform you of state fees before submission.\"}]]}],[\"$\",\"div\",\"4. Registered Agent Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"4. Registered Agent Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Registered agent service fees are refundable within 14 days of purchase if the service period has not yet begun. Once the service period starts, fees are earned and non-refundable on a pro-rata basis.\"}]]}],[\"$\",\"div\",\"5. Optional Add-On Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"5. Optional Add-On Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Optional add-on services including EIN application assistance, BOI filing, mail forwarding, and virtual address: (a) Full refund within 7 days if the service has not been initiated; (b) No refund once the application or service has been submitted to the relevant authority or initiated.\"}]]}],\"$L37\",\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\"]}]]}]}]}],[\"$L3f\",\"$L40\"],\"$L41\"]}]\n42:[]\n26:\"$W42\"\n27:[\"$\",\"$3\",\"h\",{\"children\":[null,[\"$\",\"$L43\",null,{\"children\":\"$L44\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L45\",null,{\"children\":[\"$\",\"$46\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L47\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n29:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0ct-sps8aufrd.css\",\"precedence\":\"next\",\"cross