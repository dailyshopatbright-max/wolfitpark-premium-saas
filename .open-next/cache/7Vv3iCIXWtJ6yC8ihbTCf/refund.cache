-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-4xl border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-all focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3! border-border text-foreground [a]:hover:bg-muted [a]:hover:text-muted-foreground mb-4\",\"children\":\"Legal\"}],[\"$\",\"h1\",null,{\"className\":\"text-4xl font-semibold tracking-tight sm:text-5xl\",\"children\":\"Refund Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground\",\"children\":[\"Last updated: \",\"July 25, 2026\"]}],[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"div\",\"1. Overview\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"1. Overview\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark LLC is committed to customer satisfaction. This Refund Policy explains your rights and our obligations regarding refunds for our services. Please review this policy carefully before making a purchase. By purchasing our services, you agree to the terms of this policy.\"}]]}],[\"$\",\"div\",\"2. Service Fees (Formation Packages)\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"2. Service Fees (Formation Packages)\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Our service fees for business formation and filing assistance are refundable according to the following schedule: (a) Full refund within 14 calendar days of purchase if we have not yet filed any documents with the state or commenced work on your order; (b) 50% refund if work has commenced but no state filing has been submitted; (c) No refund after state filing has been submitted. State processing times and outcomes are outside our control.\"}]]}],[\"$\",\"div\",\"3. State Filing Fees\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"3. State Filing Fees\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"State filing fees are paid directly to government agencies (Secretary of State, Department of Corporations, etc.) and are non-refundable once submitted. This applies regardless of the application outcome, including rejection or delay. We will inform you of state fees before submission.\"}]]}],[\"$\",\"div\",\"4. Registered Agent Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"4. Registered Agent Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Registered agent service fees are refundable within 14 days of purchase if the service period has not yet begun. Once the service period starts, fees are earned and non-refundable on a pro-rata basis.\"}]]}],[\"$\",\"div\",\"5. Optional Add-On Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"5. Optional Add-On Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Optional add-on services including EIN application assistance, BOI filing, mail forwarding, and virtual address: (a) Full refund within 7 days if the service has not been initiated; (b) No refund once the application or service has been submitted to the relevant authority or initiated.\"}]]}],\"$L37\",\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\"]}]]}]}]}],[\"$L3f\",\"$L40\"],\"$L41\"]}]\n42:[]\n26:\"$W42\"\n27:[\"$\",\"$3\",\"h\",{\"children\":[null,[\"$\",\"$L43\",null,{\"children\":\"$L44\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L45\",null,{