,\"li\",\"Legal-Refund Policy\",{\"children\":[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/refund\",\"children\":\"Refund Policy\"}]}],[\"$\",\"li\",\"Legal-Shipping Policy\",{\"children\":[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/shipping\",\"children\":\"Shipping Policy\"}]}],[\"$\",\"li\",\"Legal-Cookie Policy\",{\"children\":[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/cookies\",\"children\":\"Cookie Policy\"}]}]]}]]}]\n34:[\"$\",\"div\",\"Incorporation\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-white/90\",\"children\":\"Incorporation\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 flex flex-col gap-3\",\"children\":[[\"$\",\"li\",\"Incorporation-Start Company\",{\"children\":[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/incorporation\",\"children\":\"Start Company\"}]}],[\"$\",\"li\",\"Incorporation-State Comparison\",{\"children\":[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/incorporation/states\",\"children\":\"State Comparison\"}]}],[\"$\",\"li\",\"Incorporation-Dashboard\",{\"children\":[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/dashboard\",\"children\":\"Dashboard\"}]}]]}]]}]\n35:[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6 border-t border-white/15 pt-8 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between\",\"children\":[[\"$\",\"p\",null,{\"children\":\"© 2026 Wolfitpark. All rights reserved.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-4\",\"children\":[[\"$\",\"$L2c\",null,{\"href\":\"/privacy\",\"className\":\"transition-colors hover:text-white\",\"children\":\"Privacy\"}],[\"$\",\"$L2c\",null,{\"href\":\"/terms\",\"className\":\"transition-colors hover:text-white\",\"children\":\"Terms\"}],[\"$\",\"$L2c\",null,{\"href\":\"/refund\",\"className\":\"transition-colors hover:text-white\",\"children\":\"Refunds\"}],[\"$\",\"$L2c\",null,{\"href\":\"/shipping\",\"className\":\"transition-colors hover:text-white\",\"children\":\"Shipping\"}],[\"$\",\"$L2c\",null,{\"href\":\"/cookies\",\"className\":\"transition-colors hover:text-white\",\"children\":\"Cookies\"}]]}]]}]\n37:[\"$\",\"div\",\"6. Subscription Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"6. Subscription Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Monthly subscription services (compliance monitoring, annual report reminders, etc.): (a) Cancellable at any time; (b) You retain access until the end of your current billing period; (c) No partial refunds for unused portions of a billing period; (d) Annual subscriptions are refundable on a pro-rata basis for the unused portion, minus a 10% processing fee.\"}]]}]\n38:[\"$\",\"div\",\"7. Custom Development and Enterprise Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"7. Custom Development and Enterprise Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Custom software development, enterprise agreements, and consulting services are governed by the refund and cancellation terms specified in your individual service contract or statement of work. These typically include milestone-based payment schedules with refund terms tied to completed deliverables.\"}]]}]\n39:[\"$\",\"div\",\"8. Payment Disputes\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"8. Payment Disputes\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If you believe a charge is incorrect, please contact us immediately at billing@wolfitpark.online. We will investigate and respond within 5 business days. Unresolved disputes may be submitted to your financial institution or through binding arbitration as described in our Terms & Conditions.\"}]]}]\n3a:[\"$\",\"div\",\"9. Refund Processing\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"9. Refund Processing\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Approved refunds are processed within 5-10 business days. Refunds are credited to your original payment method: (a) Credit/debit card refunds — 5-10 business days to appear on your statement; (b) Cryptocurrency refunds — processed within 24 hours, subject to blockchain network confirmations; (c) ACH/wire refunds — 5-7 business days. Cryptocurrency refunds are denominated in the original cryptocurrency at the exchange rate at the time of refund processing.\"}]]}]\n3b:[\"$\",\"div\",\"10. Chargeback Policy\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"10. Chargeback Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If you initiate a chargeback with your financial institution before contacting us, your account may be immediately suspended. We will provide transaction records to your financial institution to dispute the chargeback. Wrongful chargebacks may result in a $25 administrative fee.\"}]]}]\n3c:[\"$\",\"div\",\"11. Exceptions\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"11. Exceptions\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Exceptions to this Refund Policy may be made at Wolfitpark's sole discretion in extraordinary circumstances. All exceptions must be documented in writing and approved by a Wolfitpark manager.\"}]]}]\n3d:[\"$\",\"div\",\"12. Governing Law\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"12. Governing Law\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"This Refund Policy is governed by the laws of the State of Wyoming, United States. Any disputes regarding refunds shall be resolved through the dispute resolution process outlined in our Terms & Conditions.\"}]]}]\n3e:[\"$\",\"div\",\"13. Contact\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"13. Contact\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"For refund requests or questions, contact: Wolfitpark LLC, 30 N Gould St, Sheridan, WY 82801, USA. Email: billing@wolfitpark.online. Phone: +1 (307) 555-0199.\"}]]}]\n3f:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/152qdn4mqqc97.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n40:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0fwfw3zr_x.b_.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n41:[\"$\",\"$L48\",null,{\"children\":[\"$\",\"$46\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@49\"}]}]\n44:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#020617\"}]]\n4a:I[6726,[\"/_next/static/chunks/0w2c.i2ky0ich.js\",\"/_next/static/chunks/0anfux3ged1uf.js\",\"/_next/static/chunks/09l_6s1m2kd2f.js\",\"/_next/static/chunks/02b7ej9gu8jmt.js\",\"/_next/static/chunks/0wlqa3t_j6b22.js\",\"/_next/static/chunks/0t698yywsb5~-.js\",\"/_next/static/chunks/0xjrnv1po9n~0.js\",\"/_next/static/chunks/1181pbou.tkp3.js\",\"/_next/static/chunks/0c-0zwsf8nv_k.js\",\"/_next/static/chunks/14p1p_ukyy748.js\"],\"IconMark\"]\n47:[[\"$\",\"title\",\"0\",{\"children\":\"Refund Policy | Wolfitpark\"}],[\"$\",\"meta\",\"1\",{\"na