n\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"1. Acceptance of Terms\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"By accessing, using, or purchasing any services from Wolfitpark LLC (\\\"Wolfitpark,\\\" \\\"we,\\\" \\\"our,\\\" or \\\"us\\\"), you agree to be bound by these Terms & Conditions (\\\"Terms\\\"). If you do not agree to all terms, do not use our website or services. These Terms constitute a legally binding agreement between you and Wolfitpark LLC.\"}]]}],[\"$\",\"div\",\"2. Services Description\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"2. Services Description\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark provides business formation services, registered agent services, EIN/ITIN application assistance, BOI/FinCEN filing assistance, compliance monitoring, virtual business address and mail forwarding, software development, AI automation, and related business support services. Service details, scope, and fees are specified in your service agreement or order confirmation.\"}]]}],[\"$\",\"div\",\"3. Eligibility\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"3. Eligibility\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"By using our services, you represent and warrant that: (a) You are at least 18 years of age; (b) You have the legal capacity to enter into binding contracts; (c) You are not located in a jurisdiction that is subject to US or international sanctions; (d) The information you provide is accurate, complete, and current; (e) You are not using our services for any illegal or unauthorized purpose.\"}]]}],[\"$\",\"div\",\"4. Account Registration\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"4. Account Registration\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"You must create an account to access certain services. You are responsible for maintaining the confidentiality of your login credentials and for all activities under your account. You agree to notify us immediately of any unauthorized use. We reserve the right to suspend or terminate accounts for security violations or non-compliance.\"}]]}],[\"$\",\"div\",\"5. User Obligations\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"5. User Obligations\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"You agree to: (a) Provide accurate, current, and complete information; (b) Update your information promptly when changes occur; (c) Use services in compliance with all applicable federal, state, and local laws; (d) Not engage in fraud, misrepresentation, or illegal activities; (e) Not attempt to access, modify, or damage our systems or data; (f) Not use our services to launder money, evade taxes, or conceal beneficial ownership.\"}]]}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\"]}]]}]}]}],[\"$L11\",\"$L12\"],\"$L13\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"7Vv3iCIXWtJ6yC8ihbTCf\"}\n3:[\"$\",\"div\",\"6. Incorporation and Filing Services\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"6. Incorporation and Filing Services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark assists with preparing and filing business formation documents with state authorities. We are not a law firm and do not provide legal advice. State filing fees are separate from our service fees and are paid directly to government agencies. Approval timelines vary by state. We do not guarantee specific processing times or outcomes. You are responsible for reviewing all documents and ensuring accuracy before filing.\"}]]}]\n4:[\"$\",\"div\",\"7. Payment Terms\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"7. Payment Terms\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Fees for services are as specified in your order confirmation or service agreement. Payment is due at the time of order unless otherwise agreed. Accepted payment methods include: credit/debit cards (Visa, Mastercard, American Express, Discover), cryptocurrency (Bitcoin, Ethereum, USDC), and ACH bank transfers. All prices are in US Dollars. We reserve the right to change prices with 30 days notice. Late payments may incur a 1.5% monthly finance charge.\"}]]}]\n5:[\"$\",\"div\",\"8. Refund Policy\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"8. Refund Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Refunds are governed by our Refund Policy, which is incorporated into these Terms by reference. Service fees are eligible for a full refund within 14 days if work has not commenced. State filing fees are non-refundable once submitted. Optional services may be cancelled within 7 days for a full refund if unfulfilled. Custom development projects are governed by the refund terms in your specific contract.\"}]]}]\n6:[\"$\",\"div\",\"9. Intellectual Property\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"9. Intellectual Property\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark retains all rights, title, and interest in our proprietary technology, software, tools, templates, and methodologies. Upon full payment, clients receive ownership of custom deliverables specifically created for their project. You may not reproduce, modify, distribute, or reverse-engineer our proprietary materials without written permission.\"}]]}]\n7:[\"$\",\"div\",\"10. Confidentiality\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"10. Confidentiality\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Both parties agree to maintain confidentiality of non-public information shared during the course of business. Confidential information includes business plans, financial data, technical specifications, and customer data. This obligation survives termination of our agreement for 5 years.\"}]]}]\n8:[\"$\",\"div\",\"11. Limitation of Liability\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"11. Limitation of Liability\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"To the maximum extent permitted by applicable law: (a) Wolfitpark's total liability for any claim arising from these Terms or our services is limited to the amount you paid us in the 12 months preceding the claim; (b) We are not liable for indirect, incidental, special, consequential, or punitive damages; (c) We are not liable for damages resulting from government action, regulatory changes, or third-party service failures; (d) We are not liable for delays caused by force majeure events including natural disasters, war, terrorism, or pandemic.\"}]]}]\n9:[\"$\",\"div\",\"12. Disclaimer of Warranties\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"12. Disclaimer of Warranties\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Our services are provided 'as is' and 'as available' without warranties of any kind, either express or implied. We do not warrant that services will be uninterrupted, error-free, or meet your specific requirements. State filing services are dependent on government processing and we cannot guarantee specific outcomes or timelines.\"}]]}]\na:[\"$\",\"div\",\"13. Indemnification\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"13. Indemnification\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"You agree to indemnify and hold Wolfitpark, its officers, employees, and agents harmless from any claims, damages, losses, liabilities, and expenses (including reasonable legal fees) arising from: (a) Your use of our services; (b) Your violation of these Terms; (c) Your violation of applicable laws; (d) Information you provide that is inaccurate or fraudulent.\"}]]}]\nb:[\"$\",\"div\",\"14. Termination\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"14. Termination\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Either party may terminate agreements as specified in your service contract. We reserve the right to suspend or terminate access to our services immediately if: (a) You breach these Terms; (b) You engage in fraudulent or illegal activity; (c) Required by law or regulatory authority; (d) You fail to pay fees when due. Upon termination, you remain liable for all fees incurred.\"}]]}]\nc:[\"$\",\"div\",\"15. Governing Law and Dispute Resolution\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"15. Governing Law and Dispute Resolution\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"These Terms are governed by the laws of the State of Wyoming, United States, without regard to conflict of law principles. Any disputes shall first be attempted to be resolved through good-faith negotiation. If unresolved, disputes shall be settled by binding arbitration in Sheridan County, Wyoming, administered by the American Arbitration Association. The prevailing party shall be entitled to reasonable attorney fees.\"}]]}]\nd:[\"$\",\"div\",\"16. Entire Agreement\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"16. Entire Agreement\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"These Terms, together with our Privacy Policy, Refund Policy, and any service agreements, constitute the entire agreement between you and Wolfitpark regarding your use of our services. They supersede all prior or contemporaneous agreements, communications, and proposals.\"}]]}]\ne:[\"$\",\"div\",\"17. Severability\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"17. Severability\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If any provision of these Terms is found to be invalid or unenforceable, the remaining provisions shall remain in full force and effect.\"}]]}]\nf:[\"$\",\"div\",\"18. Changes to Terms\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"18. Changes to Terms\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We may modify these Terms at any time. Changes are effective immediately upon posting. We will notify you of material changes via email or website notice. Continued use of services after changes constitutes acceptance.\"}]]}]\n10:[\"$\",\"div\",\"19. Contact\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"19. Contact\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"For questions about these Terms, contact: Wolfitpark LLC, 30 N Gould St, Sheridan, WY 82801, USA. Email: legal@wolfitpark.online. Phone: +1 (307) 555-0199.\"}]]}]\n11:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/152qdn4mqqc97.js\",\"async\":true}]\n12:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/sta