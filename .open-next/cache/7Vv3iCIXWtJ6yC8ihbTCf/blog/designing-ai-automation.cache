y/80\",\"children\":\"AI\"}],[\"$\",\"span\",null,{\"className\":\"flex items-center gap-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"$L3\",null,{\"iconNode\":[[\"circle\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\",\"key\":\"1mglay\"}],[\"path\",{\"d\":\"M12 6v6h4\",\"key\":\"135r8i\"}]],\"className\":\"lucide-clock3 lucide-clock-3 size-3.5\"}],\"7 min read\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 text-balance text-4xl font-semibold tracking-tight sm:text-6xl\",\"children\":\"Designing AI automation that earns operational trust\"}],[\"$\",\"p\",null,{\"className\":\"mt-6 max-w-2xl text-xl leading-relaxed text-muted-foreground\",\"children\":\"A practical framework for choosing the right tasks, controls, and measures before scaling intelligent automation.\"}],[\"$\",\"p\",null,{\"className\":\"mt-8 text-sm text-muted-foreground\",\"children\":[\"Wolfitpark Editorial · \",\"July 8, 2026\"]}]]}]}],[\"$\",\"div\",null,{\"className\":\"container-site max-w-3xl py-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-7 text-base leading-8 text-muted-foreground\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":\"The strongest AI initiatives begin by defining the operational behavior that should change, not by selecting a tool. Teams often feel pressure to automate quickly, but speed without context can reinforce the very friction the system was meant to remove.\"}],[\"$\",\"p\",\"1\",{\"children\":\"Start with the moments where people wait, repeat work, reconcile conflicting information, or make decisions without sufficient context. These friction points reveal where AI can have the greatest impact with the least risk.\"}],[\"$\",\"p\",\"2\",{\"children\":\"Map the decision owner, the information needed, the acceptable level of uncertainty, and the consequence of getting it wrong. This creates a practical boundary for automation and reveals where human judgment remains essential.\"}],[\"$\",\"p\",\"3\",{\"children\":\"Deploy in narrow, observable increments. Measure not just accuracy but how the automation changes workflow behavior. Expand based on evidence, not assumptions.\"}]]}]}]]}],[\"$\",\"section\",null,{\"className\":\"section-pad bg-muted/30 border-y border-border\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-site\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-2xl mx-auto text-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-[.22em] text-primary justify-center\",\"children\":[[\"$\",\"$L3\",null,{\"iconNode\":[[\"path\",{\"d\":\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\",\"key\":\"1s2grr\"}],[\"path\",{\"d\":\"M20 2v4\",\"key\":\"1rf3ol\"}],[\"path\",{\"d\":\"M22 4h-4\",\"key\":\"gwowj6\"}],[\"circle\",{\"cx\":\"4\",\"cy\":\"20\",\"r\":\"2\",\"key\":\"6kqj1y\"}]],\"className\":\"lucide-sparkles size-3.5\"}],\"Continue Reading\"]}],\"$L4\",\"$undefined\"]}],\"$L5\"]}]}],\"$L6\",\"$L7\"],[\"$L8\",\"$L9\"],\"$La\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"7Vv3iCIXWtJ6yC8ihbTCf\"}\n4:[\"$\",\"h2\",null,{\"className\":\"text-balance text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl\",\"children\":\"Related insights.\"}]\n5:[\"$\",\"div\",null,{\"className\":\"mt-10 grid gap-5 md:grid-cols-2\",\"children\":[[\"$\",\"$L2\",\"erp-modernization\",{\"href\":\"/blog/erp-modernization\",\"className\":\"group rounded-2xl border border-border bg-card p-6 transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5\",\"children\":[[\"$\",\"span\",null,{\"data-slot\":\"badge\",\"data-variant\":\"secondary\",\"className\":\"group/badge inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded