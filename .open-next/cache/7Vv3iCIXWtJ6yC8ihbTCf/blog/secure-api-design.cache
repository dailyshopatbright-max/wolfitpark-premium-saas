 Good observability is the foundation of incident response.\"}]]}]}]]}],[\"$\",\"section\",null,{\"className\":\"section-pad bg-muted/30 border-y border-border\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-site\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-2xl mx-auto text-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-[.22em] text-primary justify-center\",\"children\":[[\"$\",\"$L2f\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\",\"key\":\"1s2grr\"}],[\"path\",{\"d\":\"M20 2v4\",\"key\":\"1rf3ol\"}],[\"path\",{\"d\":\"M22 4h-4\",\"key\":\"gwowj6\"}],[\"circle\",{\"cx\":\"4\",\"cy\":\"20\",\"r\":\"2\",\"key\":\"6kqj1y\"}]],\"className\":\"lucide-sparkles size-3.5\"}],\"Continue Reading\"]}],\"$L41\",\"$undefined\"]}],\"$L42\"]}]}],\"$L43\",\"$L44\"]\n45:I[76140,[\"/_next/static/chunks/0w2c.i2ky0ich.js\",\"/_next/static/chunks/0anfux3ged1uf.js\",\"/_next/static/chunks/09l_6s1m2kd2f.js\",\"/_next/static/chunks/02b7ej9gu8jmt.js\",\"/_next/static/chunks/0wlqa3t_j6b22.js\",\"/_next/static/chunks/0t698yywsb5~-.js\",\"/_next/static/chunks/0xjrnv1po9n~0.js\",\"/_next/static/chunks/1181pbou.tkp3.js\",\"/_next/static/chunks/0c-0zwsf8nv_k.js\",\"/_next/static/chunks/14p1p_ukyy748.js\",\"/_next/static/chunks/03g83r72wg7q1.js\",\"/_next/static/chunks/02tkceh-f1-mw.js\"],\"NewsletterForm\"]\n41:[\"$\",\"h2\",null,{\"className\":\"text-balance text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl\",\"children\":\"Related insights.\"}]\n42:[\"$\",\"div\",null,{\"className\":\"mt-10 grid gap-5 md:grid-cols-2\",\"children\":[[\"$\",\"$L2e\",\"designing-ai-automation\",{\"href\":\"/blog/design