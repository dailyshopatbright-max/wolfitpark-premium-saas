,\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n25:[\"$\",\"$3\",\"c\",{\"children\":[[\"$\",\"$L36\",null,{\"children\":[\"$\",\"section\",null,{\"className\":\"section-pad\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-site max-w-4xl\",\"children\":[[\"$\",\"span\",null,{\"data-slot\":\"badge\",\"data-variant\":\"outline\",\"className\":\"group/badge inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-4xl border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-all focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3! border-border text-foreground [a]:hover:bg-muted [a]:hover:text-muted-foreground mb-4\",\"children\":\"Legal\"}],[\"$\",\"h1\",null,{\"className\":\"text-4xl font-semibold tracking-tight sm:text-5xl\",\"children\":\"Cookie Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground\",\"children\":[\"Last updated: \",\"July 25, 2026\"]}],[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"div\",\"1. What Are Cookies\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"1. What Are Cookies\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Cookies are small text files stored on your device (computer, tablet, mobile) when you visit a website. They are widely used to make websites work efficiently, enhance user experience, and provide information to website owners. Similar technologies include web beacons, pixel tags, and local storage.\"}]]}],[\"$\",\"div\",\"2. How We Use Cookies\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"2. How We Use Cookies\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark LLC uses cookies and similar technologies for the following purposes: (a) Essential/Strictly Necessary — required for website operation, including authentication, security, and session management; (b) Analytics/Performance — to understand how visitors interact with our website, measure traffic, and improve performance; (c) Functional/Preference — to remember your preferences, language, and region settings; (d) Targeting/Advertising — used sparingly to deliver relevant content and measure campaign effectiveness.\"}]]}],[\"$\",\"div\",\"3. Cookies We Use\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"3. Cookies We Use\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Essential cookies: session cookies for login authentication, CSRF tokens for security, load balancing cookies. Analytics cookies: Google Analytics (anonymized IP), Vercel Analytics, PostHog (self-hosted). Functional cookies: theme preference, language selection, recently viewed items. We do not use third-party advertising cookies without your explicit consent.\"}]]}],[\"$\",\"div\",\"4. Third-Party Cookies\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"4. Third-Party Cookies\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Some cookies are placed by trusted third-party services we use: (a) Vercel — website hosting and analytics; (b) Stripe — payment processing (does not use cookies for tracking); (c) Google Analytics — anonymized usage analytics; (d) Resend — email delivery and analytics. These third parties have their own privacy and cookie policies.\"}]]}],[\"$\",\"div\",\"5. Your Cookie Choices\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"5. Your Cookie Choices\"}],\"$L37\"]}],\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\"]}]]}]}]}],[\"$L3d\",\"$L3e\"],\"$L3f\"]}]\n40:[]\n26:\"$W40\"\n27:[\"$\",\"$3\",\"h\",{\"children\":[null,[\"$\",\"$L41\",null,{\"children\":\"$L42\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L43\",null,{\"children\":[\"$\",\"$44\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L45\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n29:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0ct-sps8aufrd.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n2a:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0djcck_ky6z0o.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n46:I[76779,[\"/_next/static/chunks/0w2c.i2ky0ich.js\",\"/_next/static/chunks/0anfux3ged1uf.js\",\"/_next/static/chunks/09l_6s1m2kd2f.js\",\"/_next/static/chunks/02b7ej9gu8jmt.js\",\"/_next/static/chunks/0wlqa3t_j6b22.js\",\"/_next/static/chunks/0t698yywsb5~-.js\",\"/_next/static/chunks/0xjrnv1po9n~0.js\",\"/_next/static/chunks/1181pbou.tkp3.js\",\"/_next/static/chunks/0c-0zwsf8nv_k.js\",\"/_next/static/chunks/14p1p_ukyy748.js\"],\"OutletBoundary\"]\n2e:[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/services\",\"children\":\"AI & Automation\"}]\n2f:[\"$\",\"li\",\"Services-Cloud & Data\",{\"children\":[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/services\",\"children\":\"Cloud & Data\"}]}]\n30:[\"$\",\"li\",\"Services-All Services\",{\"children\":[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/services\",\"children\":\"All Services\"}]}]\n31:[\"$\",\"div\",\"Solutions\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-white/90\",\"childre