ookies for login authentication, CSRF tokens for security, load balancing cookies. Analytics cookies: Google Analytics (anonymized IP), Vercel Analytics, PostHog (self-hosted). Functional cookies: theme preference, language selection, recently viewed items. We do not use third-party advertising cookies without your explicit consent.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"4. Third-Party Cookies\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"4. Third-Party Cookies\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Some cookies are placed by trusted third-party services we use: (a) Vercel — website hosting and analytics; (b) Stripe — payment processing (does not use cookies for tracking); (c) Google Analytics — anonymized usage analytics; (d) Resend — email delivery and analytics. These third parties have their own privacy and cookie policies.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"5. Your Cookie Choices\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"5. Your Cookie Choices\\\"}],\\\"$L37\\\"]}],\\\"$L38\\\",\\\"$L39\\\",\\\"$L3a\\\",\\\"$L3b\\\",\\\"$L3c\\\"]}]]}]}]}],[\\\"$L3d\\\",\\\"$L3e\\\"],\\\"$L3f\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"40:[]\\n26:\\\"$W40\\\"\\n27:[\\\"$\\\",\\\"$3\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L41\\\",null,{\\\"children\\\":\\\"$L42\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L43\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$44\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L45\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}]\\n29:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0ct-sps8aufrd.css\\\",\\\"precedence\\\":\\\"nex