e limit tracking to essential cookies only.\"}]]}]\n39:[\"$\",\"div\",\"7. Data Collected via Cookies\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"7. Data Collected via Cookies\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Cookies may collect: IP address, browser type and version, operating system, referring URL, pages visited, time spent on pages, and click patterns. This data is aggregated and anonymized where possible.\"}]]}]\n3a:[\"$\",\"div\",\"8. Cookie Retention\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"8. Cookie Retention\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Session cookies expire when you close your browser. Persistent cookies remain on your device for up to 12 months or until manually deleted. You can delete persistent cookies through your browser settings at any time.\"}]]}]\n3b:[\"$\",\"div\",\"9. Updates to This Policy\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"9. Updates to This Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We may update this Cookie Policy. Changes will be posted here with an updated revision date. Material changes will be communicated via cookie consent banner or email.\"}]]}]\n3c:[\"$\",\"div\",\"10. Contact\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"10. Contact\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"For questions about our use of cookies, contact: Wolfitpark LLC, 30 N Gould St, Sheridan, WY 82801, USA. Email: privacy@wolfitpark.online.\"}]]}]\n3d:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/152qdn4mqqc97.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n3e:[\"$\",\"script\",\"script-1\",{\"src\"