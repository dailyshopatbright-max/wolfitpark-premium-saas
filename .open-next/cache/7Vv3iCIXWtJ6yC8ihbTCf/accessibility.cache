t-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/contact\",\"children\":\"Contact\"}]}]]}]]}],[\"$\",\"div\",\"Services\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-white/90\",\"children\":\"Services\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 flex flex-col gap-3\",\"children\":[[\"$\",\"li\",\"Services-Custom Software\",{\"children\":[\"$\",\"$L2c\",null,{\"className\":\"text-sm text-white/60 transition-colors hover:text-white\",\"href\":\"/services\",\"children\":\"Custom Software\"}]}],[\"$\",\"li\",\"Services-AI & Automation\",{\"children\":\"$L2e\"}],\"$L2f\",\"$L30\"]}]]}],\"$L31\",\"$L32\",\"$L33\",\"$L34\"]}]]}],\"$L35\"]}]]}]}]\n23:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Wolfitpark\\\",\\\"url\\\":\\\"https://wolfitpark.online\\\",\\\"email\\\":\\\"support@wolfitpark.online\\\",\\\"address\\\":{\\\"@type\\\":\\\"PostalAddress\\\",\\\"streetAddress\\\":\\\"30 N Gould St\\\",\\\"addressLocality\\\":\\\"Sheridan\\\",\\\"addressRegion\\\":\\\"WY\\\",\\\"postalCode\\\":\\\"82801\\\",\\\"addressCountry\\\":\\\"US\\\"},\\\"sameAs\\\":[]}\"}}]\n24:[\"$\",\"$3\",\"c\",{\"children\":[null,[\"$\",\"$L9\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$La\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n25:[\"$\",\"$3\",\"c\",{\"children\":[[\"$\",\"$L36\",null,{\"children\":[\"$\",\"section\",null,{\"className\":\"section-pad\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-site max-w-4xl\",\"children\":[[\"$\",\"span\",null,{\"data-slot\":\"badge\",\"data-variant\":\"outline\",\"className\":\"group/badge inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-4xl border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-all focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3! border-border text-foreground [a]:hover:bg-muted [a]:hover:text-muted-foreground mb-4\",\"children\":\"Legal\"}],[\"$\",\"h1\",null,{\"className\":\"text-4xl font-semibold tracking-tight sm:text-5xl\",\"children\":\"Accessibility Statement\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground\",\"children\":[\"Last updated: \",\"July 25, 2026\"]}],[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"div\",\"1. Commitment\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"1. Commitment\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Wolfitpark LLC is committed to ensuring digital accessibility for all users, including individuals with disabilities. We continuously work to improve the accessibility and usability of our website and services. We believe everyone should be able to access and benefit from our platform regardless of ability.\"}]]}],[\"$\",\"div\",\"2. Standards\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"2. Standards\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We strive to conform to the Web Content Accessibility Guidelines (WCAG) 2.1 Level AA standards published by the World Wide Web Consortium (W3C). These guidelines outline best practices for making web content accessible to users with various disabilities including visual, auditory, physical, speech, cognitive, and neurological disabilities.\"}]]}],[\"$\",\"div\",\"3. Accessibility Features\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"3. Accessibility Features\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"Our website includes the following accessibility features: (a) Keyboard navigation that is logical and consistent; (b) Screen reader compatibility with proper ARIA labels and semantic HTML structure; (c) Sufficient color contrast ratios meeting WCAG AA standards; (d) Resizable text up to 200% without loss of functionality; (e) Alternative text for meaningful images; (f) Descriptive link text — no 'click here' links; (g) Focus indicators for keyboard navigation; (h) Skip navigation links to bypass repeated content; (i) Captions and transcripts for video content where applicable.\"}]]}],[\"$\",\"div\",\"4. Ongoing Efforts\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"4. Ongoing Efforts\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We employ the following practices to maintain and improve accessibility: (a) Regular automated accessibility audits using industry-standard tools; (b) Periodic manual testing by users with assistive technologies; (c) Accessibility considerations integrated into our design and development workflow; (d) Staff training on inclusive design and accessibility best practices; (e) Third-party accessibility audits conducted annually.\"}]]}],\"$L37\",\"$L38\",\"$L39\",\"$L3a\",\"$L3b\"]}]]}]}]}],[\"$L3c\",\"$L3d\"],\"$L3e\"]}]\n3f:[]\n26:\"$W3f\"\n27:[\"$\",\"$3\",\"h\",{\"children\":[null,[\"$\",\"$L40\",null,{\"children\":\"$L41\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L42\",null,{\"children\":[\"$\",\"$43\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L44\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n29:[\"$\",\"lin