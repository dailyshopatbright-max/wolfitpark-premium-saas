"className\":\"text-xl font-semibold\",\"children\":\"7. Feedback and Contact\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We welcome feedback on the accessibility of our website and services. If you encounter accessibility barriers, need assistance accessing any content, or wish to report an issue, please contact us: Email: accessibility@wolfitpark.online. Phone: +1 (307) 555-0199. We will make every reasonable effort to provide the information or service in an accessible format.\"}]]}]\n3a:[\"$\",\"div\",\"8. Accommodation Request\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"8. Accommodation Request\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"If you require a reasonable accommodation to access our services, please contact us. We will work with you to identify and provide an appropriate accommodation in a timely manner.\"}]]}]\n3b:[\"$\",\"div\",\"9. Policy Updates\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-semibold\",\"children\":\"9. Policy Updates\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted-foreground leading-relaxed\",\"children\":\"We review and update this Accessibility Statement at least annually or when significant changes are made to our website or accessibility practices.\"}]]}]\n3c:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/152qdn4mqqc97.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n3d:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0fwfw3zr_x.b_.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n3e:[\"$\",\"$L45\",null,{\"children\":[\"$\",\"$43\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@46\"}]}]\n41:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#020617\"}]]\