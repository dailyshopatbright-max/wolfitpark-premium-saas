":[\\\"Last updated: \\\",\\\"July 25, 2026\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-12 space-y-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"1. Commitment\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"1. Commitment\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Wolfitpark LLC is committed to ensuring digital accessibility for all users, including individuals with disabilities. We continuously work to improve the accessibility and usability of our website and services. We believe everyone should be able to access and benefit from our platform regardless of ability.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"2. Standards\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"2. Standards\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We strive to conform to the Web Content Accessibility Guidelines (WCAG) 2.1 Level AA standards published by the World Wide Web Consortium (W3C). These guidelines outline best practices for making web content accessible to users with various disabilities including visual, auditory, physical, speech, cognitive, and neurological disabilities.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"3. Accessibility Features\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"3. Accessibility Features\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Our website includes the following accessibility features: (a) Keyboard navigation that is logical and consistent; (b) Screen reader compatibility with proper ARIA labels and semantic HTML structure; (c) Sufficient color contrast ratios meeting WCAG AA standards; (d) Resizable text up to 200% without loss of functionality; (e) Alternative text for meaningful images; (f) Descriptive link text — no 'click here' links; (g) Focus indicators for keyboard navigation; (h) Skip navigation links to bypass repeated content; (i) Captions and transcripts for video content where applicable.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"4. Ongoing Efforts\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-xl font-semibold\\\",\\\"children\\\":\\\"4. Ongoing Efforts\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We employ the following practices to maintain and improve accessibility: (a) Regular automated accessibility audits using industry-standard tools; (b) Periodic manual testing by users with assistive technologies; (c) Accessibility considerations integrated into our design and development workflow; (d) Staff training on inclusive design and accessibility best practices; (e) Third-party accessibility audits conducted annually.\\\"}]]}],\\\"$L37\\\",\\\"$L38\\\",\\\"$L39\\\",\\\"$L3a\\\",\\\"$L3b\\\"]}]]}]}]}],[\\\"$L3c\\\",\\\"$L3d\\\"],\\\"$L3e\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"3f:[]\\n26:\\\"$W3f\\\"\\n27:[\\\"$\\\",\\\"$3\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L40\\\",null,{\\\"children\\\":\\\"$L41\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L42\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$43\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L44\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}]\\n29:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0ct-sps8aufrd.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]\\n2a:[\\\"$\\\",\\\"link\\\",\\\"1\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\